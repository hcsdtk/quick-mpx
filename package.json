{
  "name": "quick-mpx-weapp-mall",
  "version": "0.1.0",
  "description": "A cross-platform mall starter built with Mpx.",
  "scripts": {
    "serve": "mpx-cli-service serve",
    "serve:cross": "mpx-cli-service serve --targets=wx,ali,web",
    "serve:ali": "mpx-cli-service serve --targets=ali",
    "serve:web": "mpx-cli-service serve --targets=web",
    "build": "mpx-cli-service build",
    "build:cross": "mpx-cli-service build --targets=wx,ali,web",
    "build:ali": "mpx-cli-service build --targets=ali",
    "build:web": "mpx-cli-service build --targets=web",
    "lint": "eslint --ext .js,.mpx src/",
    "lint:fix": "npm run lint -- --fix",
    "clean": "rimraf dist .cache",
    "verify": "npm run lint && npm run build",
    "help": "mpx-cli-service help"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hcsdtk/quick-mpx-weapp-mall.git"
  },
  "bugs": {
    "url": "https://github.com/hcsdtk/quick-mpx-weapp-mall/issues"
  },
  "homepage": "https://github.com/hcsdtk/quick-mpx-weapp-mall#readme",
  "keywords": [
    "mpx",
    "miniprogram",
    "wechat",
    "mall"
  ],
  "author": "chasen <hcsdtk@sina.com>",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.18.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@mpxjs/api-proxy": "^2.11.1",
    "@mpxjs/core": "^2.11.1",
    "@mpxjs/fetch": "^2.11.1",
    "@mpxjs/store": "^2.11.0",
    "vue": "^2.7.16",
    "vue-i18n": "^8.28.2",
    "vue-i18n-bridge": "^9.14.1",
    "vue-router": "^3.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/runtime-corejs3": "^7.29.7",
    "@mpxjs/babel-plugin-inject-page-events": "^2.10.21",
    "@mpxjs/eslint-config": "^2.0.14",
    "@mpxjs/mpx-cli-service": "^2.2.30",
    "@mpxjs/vue-cli-plugin-mpx": "^2.2.30",
    "@mpxjs/webpack-plugin": "^2.11.1",
    "eslint": "^9.39.5",
    "process": "^0.11.10",
    "rimraf": "^5.0.10",
    "stylus": "^0.64.0",
    "stylus-loader": "^8.1.0",
    "webpack": "^5.109.2"
  }
}
