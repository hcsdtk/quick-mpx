<template>
  <view class="mask" wx:if="{{show}}" bindtap="tapHandle"></view>
</template>

<script lang="ts">
import { createComponent, ref, watch } from '@mpxjs/core'

createComponent({
  properties: {
    visible: {
      //用于外部控制组件显示和隐藏
      type: Boolean,
      value: true,
    },
    isClick: {
      type: Boolean,
      value: false
    }
  },
  setup (props, { triggerEvent }) {
    const show = ref(props.visible)

    watch(() => props.visible, value => {
      show.value = value
    }, { immediate: true })

    const tapHandle = (): void => {
      if (!props.isClick) {
        return
      }
      show.value = false
      triggerEvent('maskHide')
    }

    return { show, tapHandle }
  }
})
</script>

<style lang="stylus">
@import "./../../assets/stylus/constant"
.mask
  position fixed
  left 0
  top 0
  right 0
  bottom 0
  background-color rgba(0, 0, 0, 0.2)
  z-index mask-zindex
  overflow hidden
  width 100%
  height 100%
</style>
<script type="application/json">
{
  "usingComponents": {}
}
</script>
