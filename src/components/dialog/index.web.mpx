<template>
  <mask visible="{{show}}" isClick="{{false}}"></mask>
  <view class="dialog" wx:if="{{show}}">
    <view class="dialog-title">{{ dialog.title }}</view>
    <view class="dialog-desc">
      <text>{{ dialog.content }}</text>
    </view>
    <view class="dialog-footer">
      <button class="button button-big button-circle" bindtap="close">
        {{ dialog.btnText }}
      </button>
    </view>
  </view>
</template>

<script lang="ts">
import { createComponent, ref, watch } from '@mpxjs/core'

interface DialogOptions {
  title?: string
  content?: string
  btnText?: string
}

interface DialogState {
  title: string
  content: string
  btnText: string
  resolve: () => void
}

createComponent({
  properties: {
    visible: {
      type: Boolean,
      value: false,
    }
  },
  setup (props) {
    const show = ref(props.visible)
    const noop = (): void => {}
    const dialog = ref<DialogState>({
      title: '登录小程序',
      content: '请在微信小程序中完成登录。',
      btnText: '知道了',
      resolve: noop
    })

    watch(() => props.visible, value => {
      show.value = value
    }, { immediate: true })

    const open = (options: DialogOptions = {}): Promise<void> => {
      const {
        title = '登录小程序',
        content = '请在微信小程序中完成登录。',
        btnText = '知道了'
      } = options
      return new Promise(resolve => {
        dialog.value = { title, content, btnText, resolve }
        show.value = true
      })
    }

    const close = (): void => {
      const resolve = dialog.value.resolve || noop
      show.value = false
      resolve()
    }

    return { show, dialog, open, close }
  }
})
</script>

<style lang="stylus">
@import "./../../assets/stylus/constant"
@import "./../../assets/stylus/button"
.dialog
  position absolute
  right auto
  bottom auto
  top 50%
  left 50%
  height auto
  width 290px
  z-index dialog-zindex
  background-color white-color
  border-radius 6px
  padding 23px
  overflow hidden
  transform translate(-50%, -50%)

  &-title
    font-size big-font-size
    text-align center
    padding-bottom 18px
    font-weight 600

  &-desc
    text-align center
    padding-bottom 16px

  &-footer
    width 100%
    display flex
    flex-direction row
    justify-content center

    & .button
      width 100%
</style>

<script type="application/json">
{
  "usingComponents": {
    "mask": "../mask/index"
  }
}
</script>
