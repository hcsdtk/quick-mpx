<template>
  <mask visible="{{show}}" isClick="{{false}}"></mask>
  <view class="dialog" wx:if="{{show}}">
    <view class="dialog-title">{{ dialog.title }}</view>
    <view class="dialog-desc">
      <text>{{ dialog.content }}</text>
    </view>
    <view class="dialog-footer">
      <button class="button button-big button-circle" bindtap="close">
        {{ dialog.btnText }}
      </button>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

const noop = () => {}

createComponent({
  properties: {
    visible: {
      type: Boolean,
      value: false,
      observer (newValue) {
        this.show = newValue
      }
    }
  },
  data: {
    show: false,
    dialog: {
      title: '登录小程序',
      content: '请在微信小程序中完成登录。',
      btnText: '知道了',
      resolve: noop
    }
  },
  methods: {
    open (options = {}) {
      const {
        title = '登录小程序',
        content = '请在微信小程序中完成登录。',
        btnText = '知道了'
      } = options
      return new Promise(resolve => {
        this.dialog = { title, content, btnText, resolve }
        this.show = true
      })
    },
    close () {
      const resolve = this.dialog.resolve || noop
      this.show = false
      resolve({})
    }
  }
})
</script>

<style lang="stylus">
@import "./../../assets/stylus/constant"
@import "./../../assets/stylus/button"
.dialog
  position absolute
  right auto
  bottom auto
  top 50%
  left 50%
  height auto
  width 290px
  z-index dialog-zindex
  background-color white-color
  border-radius 6px
  padding 23px
  overflow hidden
  transform translate(-50%, -50%)

  &-title
    font-size big-font-size
    text-align center
    padding-bottom 18px
    font-weight 600

  &-desc
    text-align center
    padding-bottom 16px

  &-footer
    width 100%
    display flex
    flex-direction row
    justify-content center

    & .button
      width 100%
</style>

<script type="application/json">
{
  "usingComponents": {
    "mask": "../mask/index"
  }
}
</script>
