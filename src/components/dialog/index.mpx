<template>
  <mask visible="{{show}}" isClick="{{false}}"></mask>
  <view class="dialog" wx:if="{{show}}">
    <view class="dialog-title">{{ dialog.title }}</view>
    <view class="dialog-desc">
      <text>{{ dialog.content }}</text>
    </view>
    <view class="dialog-footer">
      <button
        class="button button-big button-circle"
        open-type="getUserInfo"
        bindgetuserinfo="bindgetuserinfo"
        hover-class="button-hover"
      >
        {{ dialog.btnText }}
      </button>
    </view>
  </view>
</template>

<script lang="ts">
import { createComponent, ref, watch } from '@mpxjs/core'

interface DialogOptions {
  title?: string
  content?: string
  btnText?: string
}

interface UserInfoEvent {
  detail?: {
    errMsg?: string
    [key: string]: unknown
  }
  [key: string]: unknown
}

interface DialogState {
  title: string
  content: string
  btnText: string
  resolve: (value: UserInfoEvent['detail']) => void
  reject: (reason?: unknown) => void
}

createComponent({
  properties: {
    visible: {
      //用于外部控制组件显示和隐藏
      type: Boolean,
      value: false,
    }
  },
  setup (props) {
    const show = ref(props.visible)
    const noop = (): void => {}
    const dialog = ref<DialogState>({
      title: '登录小程序',
      content: `等你好久了！\r\n欢迎来到权味+小程序。`,
      btnText: '登录权味+',
      resolve: noop,
      reject: noop
    })

    watch(() => props.visible, value => {
      show.value = value
    }, { immediate: true })

    const open = (options: DialogOptions = {}): Promise<UserInfoEvent['detail']> => {
      const {
        title = '登录小程序',
        content = `等你好久了！\r\n欢迎来到权味+小程序。`,
        btnText = '登录权味+'
      } = options
      return new Promise((resolve, reject) => {
        show.value = true
        dialog.value = {
          title,
          content,
          btnText,
          resolve,
          reject
        }
      })
    }

    const bindgetuserinfo = (event: UserInfoEvent): void => {
      const { resolve, reject } = dialog.value
      const detail = event.detail || {}
      show.value = false
      if (String(detail.errMsg || '').endsWith(':ok')) {
        resolve(detail)
      } else {
        reject(detail)
      }
    }

    return { show, dialog, open, bindgetuserinfo }
  }
})
</script>

<style lang="stylus">
@import "./../../assets/stylus/constant"
@import "./../../assets/stylus/button"
.dialog
  position absolute
  right auto
  bottom auto
  top 50%
  left 50%
  height auto
  width 290px
  z-index dialog-zindex
  background-color white-color
  border-radius 6px
  padding 23px
  overflow hidden
  transform translate(-50%, -50%)

  &-title
    font-size big-font-size
    text-align center
    padding-bottom 18px
    font-weight 600

  &-desc
    text-align center
    padding-bottom 16px

  &-footer
    width 100%
    display flex
    flex-direction row
    justify-content center

    & .button
      width 100%
</style>
<script type="application/json">
{
  "usingComponents": {
    "mask": "../mask/index"
  }
}
</script>
